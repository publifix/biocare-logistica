---
import Icon from './Icon.astro';
import { form, whatsapp } from '../data/content';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const f = form.fields;

const label = 'block text-[0.9375rem] font-semibold text-grafito';
const input =
  'mt-2 block w-full rounded-lg border border-acero bg-white px-4 py-3 text-base text-grafito placeholder:text-gris transition-colors focus:border-verde focus:outline-none focus-visible:outline-3 focus-visible:outline-offset-1 focus-visible:outline-verde aria-[invalid=true]:border-[#C93A33]';
const error = 'mt-2 hidden text-sm font-medium text-[#B3332D]';
const req = '<span aria-hidden="true" class="text-verde"> *</span>';
---
<form
  class="rounded-2xl bg-white p-6 shadow-[0_18px_48px_-24px_rgba(7,59,72,0.35)] ring-1 ring-bruma sm:p-8 lg:p-10"
  action={endpoint || undefined}
  method="post"
  novalidate
  data-contact-form
  data-endpoint={endpoint}
  data-msg-required={form.required}
  data-msg-phone={form.invalidPhone}
  data-msg-email={form.invalidEmail}
  data-msg-privacy={form.privacyRequired}
  data-msg-sending={form.sending}
>
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="nombre" class={label}>{f.nombre.label}<Fragment set:html={req} /></label>
      <input id="nombre" name="nombre" type="text" autocomplete="name" required placeholder={f.nombre.placeholder} class={input} aria-describedby="nombre-error" />
      <p id="nombre-error" class={error}></p>
    </div>
    <div>
      <label for="empresa" class={label}>{f.empresa.label}<Fragment set:html={req} /></label>
      <input id="empresa" name="empresa" type="text" autocomplete="organization" required placeholder={f.empresa.placeholder} class={input} aria-describedby="empresa-error" />
      <p id="empresa-error" class={error}></p>
    </div>
    <div>
      <label for="telefono" class={label}>{f.telefono.label}<Fragment set:html={req} /></label>
      <input id="telefono" name="telefono" type="tel" inputmode="numeric" autocomplete="tel-national" required placeholder={f.telefono.placeholder} class={input} aria-describedby="telefono-error" />
      <p id="telefono-error" class={error}></p>
    </div>
    <div>
      <label for="correo" class={label}>{f.correo.label}<Fragment set:html={req} /></label>
      <input id="correo" name="correo" type="email" autocomplete="email" required placeholder={f.correo.placeholder} class={input} aria-describedby="correo-error" />
      <p id="correo-error" class={error}></p>
    </div>
    <div>
      <label for="servicio" class={label}>{f.servicio.label}<Fragment set:html={req} /></label>
      <div class="relative">
        <select id="servicio" name="servicio" required class={`${input} appearance-none pr-11 invalid:text-gris`} aria-describedby="servicio-error">
          <option value="" disabled selected>{f.servicio.placeholder}</option>
          {f.servicio.options.map((o) => <option value={o}>{o}</option>)}
        </select>
        <Icon name="chevron" class="pointer-events-none absolute right-4 top-1/2 mt-1 size-5 -translate-y-1/2 text-gris" />
      </div>
      <p id="servicio-error" class={error}></p>
    </div>
    <div>
      <label for="puntos" class={label}>{f.puntos.label}</label>
      <input id="puntos" name="puntos" type="number" inputmode="numeric" min="1" step="1" placeholder={f.puntos.placeholder} class={input} />
    </div>
    <div class="sm:col-span-2">
      <label for="mensaje" class={label}>{f.mensaje.label}</label>
      <textarea id="mensaje" name="mensaje" rows="4" placeholder={f.mensaje.placeholder} class={`${input} resize-y`}></textarea>
    </div>
    <div class="sm:col-span-2">
      <div class="flex items-start gap-3">
        <input
          id="privacidad"
          name="privacidad"
          type="checkbox"
          value="acepto"
          required
          class="mt-0.5 size-5 shrink-0 rounded border-acero accent-verde"
          aria-describedby="privacidad-error"
        />
        <label for="privacidad" class="text-[0.9375rem] text-grafito">
          {f.privacidad.before}<a href={`${base}aviso-de-privacidad/`} class="font-semibold text-verde underline underline-offset-4">{f.privacidad.link}</a><Fragment set:html={req} />
        </label>
      </div>
      <p id="privacidad-error" class={error}></p>
    </div>
  </div>

  <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
    <button type="submit" class="btn btn-primary w-full disabled:cursor-wait disabled:opacity-80 sm:w-auto" data-submit>
      <span data-submit-label>{form.submit}</span>
    </button>
  </div>

  <div role="status" aria-live="polite" class="mt-6 empty:hidden" data-status></div>

  <template data-success>
    <div class="flex items-start gap-3 rounded-lg bg-[#E6F4EE] p-4 text-[0.9375rem] font-medium text-[#0B7A57]">
      <Icon name="check" class="mt-0.5 size-5 shrink-0" />
      <p>{form.success}</p>
    </div>
  </template>
  <template data-error>
    <div class="rounded-lg bg-[#FBEAE9] p-4 text-[0.9375rem] font-medium text-[#B3332D]">
      <p>{form.error}</p>
      <a href={whatsapp.general} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 font-semibold text-verde underline underline-offset-4">
        <Icon name="whatsapp" class="size-5" />{whatsapp.floatLabel}
      </a>
    </div>
  </template>
</form>

<script>
  const formEl = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (formEl) {
    const d = formEl.dataset;
    const status = formEl.querySelector<HTMLElement>('[data-status]')!;
    const submit = formEl.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = formEl.querySelector<HTMLElement>('[data-submit-label]')!;
    const idleLabel = submitLabel.textContent ?? '';
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    const rules: Record<string, (el: HTMLInputElement) => string> = {
      nombre: (el) => (el.value.trim() ? '' : d.msgRequired!),
      empresa: (el) => (el.value.trim() ? '' : d.msgRequired!),
      telefono: (el) => {
        const v = el.value.replace(/[\s()-]/g, '');
        if (!v) return d.msgRequired!;
        return /^\d{10}$/.test(v) ? '' : d.msgPhone!;
      },
      correo: (el) => {
        const v = el.value.trim();
        if (!v) return d.msgRequired!;
        return emailRe.test(v) ? '' : d.msgEmail!;
      },
      servicio: (el) => (el.value ? '' : d.msgRequired!),
      privacidad: (el) => (el.checked ? '' : d.msgPrivacy!),
    };

    const check = (name: string) => {
      const el = formEl.elements.namedItem(name) as HTMLInputElement;
      const msg = rules[name](el);
      const out = formEl.querySelector<HTMLElement>(`#${name}-error`)!;
      out.textContent = msg;
      out.classList.toggle('hidden', !msg);
      el.setAttribute('aria-invalid', msg ? 'true' : 'false');
      return !msg;
    };

    Object.keys(rules).forEach((name) => {
      const el = formEl.elements.namedItem(name) as HTMLInputElement;
      const evt = el.type === 'checkbox' || el.tagName === 'SELECT' ? 'change' : 'blur';
      el.addEventListener(evt, () => check(name));
      el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && check(name));
    });

    const show = (kind: 'success' | 'error') => {
      const tpl = formEl.querySelector<HTMLTemplateElement>(`[data-${kind}]`)!;
      status.replaceChildren(tpl.content.cloneNode(true));
    };

    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.replaceChildren();
      const invalid = Object.keys(rules).filter((name) => !check(name));
      if (invalid.length) {
        (formEl.elements.namedItem(invalid[0]) as HTMLElement).focus();
        return;
      }

      submit.disabled = true;
      submitLabel.textContent = d.msgSending!;
      try {
        if (!d.endpoint) throw new Error('PUBLIC_FORM_ENDPOINT no está configurado');
        const res = await fetch(d.endpoint, {
          method: 'POST',
          body: new FormData(formEl),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        formEl.reset();
        formEl.querySelectorAll('[aria-invalid]').forEach((el) => el.setAttribute('aria-invalid', 'false'));
        show('success');
      } catch {
        show('error');
      } finally {
        submit.disabled = false;
        submitLabel.textContent = idleLabel;
      }
    });
  }
</script>
