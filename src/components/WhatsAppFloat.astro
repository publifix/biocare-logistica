---
import Icon from './Icon.astro';
import { whatsapp } from '../data/content';
---
<a
  href={whatsapp.general}
  target="_blank"
  rel="noopener"
  aria-label={whatsapp.floatLabel}
  data-wa-float
  data-hidden
  inert
  class="group fixed bottom-5 right-5 z-40 inline-flex size-14 items-center justify-center rounded-full bg-verde text-white shadow-[0_8px_24px_-6px_rgba(7,59,72,0.45)] transition-[background-color,opacity,transform] duration-300 hover:bg-verde-hondo data-[hidden]:pointer-events-none data-[hidden]:translate-y-4 data-[hidden]:opacity-0 lg:bottom-8 lg:right-8"
>
  <Icon name="whatsapp" class="size-7" />
  <span
    class="pointer-events-none absolute right-full mr-3 hidden whitespace-nowrap rounded-md bg-petroleo px-3 py-2 text-sm font-medium text-white opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100 sm:block"
    aria-hidden="true"
  >
    {whatsapp.floatTooltip}
  </span>
</a>

<script>
  // El hero ya tiene su botón de WhatsApp: el flotante aparece al salir del hero para no tapar los CTA.
  const float = document.querySelector<HTMLElement>('[data-wa-float]');
  const hero = document.getElementById('inicio');
  if (float && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      float.toggleAttribute('data-hidden', entry.isIntersecting);
      float.toggleAttribute('inert', entry.isIntersecting);
    }, { rootMargin: '0px 0px -40% 0px' }).observe(hero);
  } else if (float) {
    float.removeAttribute('data-hidden');
    float.removeAttribute('inert');
  }
</script>
